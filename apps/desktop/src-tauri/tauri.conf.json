{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SYMFORYX",
  "version": "1.0.0",
  "identifier": "dev.ozkandev.symforyx",
  "build": {
    "beforeDevCommand": "bun run --filter @symforyx/web dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "bun run --filter @symforyx/web build",
    "frontendDist": "../../web/build"
  },
  "app": {
    "windows": [
      {
        "title": "SYMFORYX — AI Orchestra",
        "width": 1360,
        "height": 860,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "copyright": "© 2026 ozkandev"
  }
}
