# SYMFORYX Ortam Değişkenleri
SYMFORYX_PORT=3000
SYMFORYX_HOST=127.0.0.1
# Oturum ve Anahtar Kasası (AES-256-GCM) için uzun, rastgele gizli anahtar
SYMFORYX_SECRET=degistir-uzun-ve-rastgele-bir-anahtar-en-az-32-karakter
# SQLite veritabanı yolu (yerel mod)
SYMFORYX_DB_PATH=./data/symforyx.db
# Artefakt dosya deposu
SYMFORYX_DATA_DIR=./data
# Kod çalıştırma sandbox'ı
SANDBOX_ENABLED=true
# Yerel Ollama adresi
OLLAMA_BASE_URL=http://localhost:11434
# Sunucu modu ayarları
ALLOW_SIGNUP=true
SYMFORYX_WEB_ORIGIN=http://localhost:5173
